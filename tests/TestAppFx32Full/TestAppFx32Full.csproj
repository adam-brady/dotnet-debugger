<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TestAppFx as old non-SDK .NET Framework projects often are: x86, with a Windows ("full") PDB (X86AdapterTests, Windows
    only; needs a win-x86 build of the adapter). Same sources, so the same "// bp:fx_*" markers apply.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TestAppFx32Full</AssemblyName>
    <RootNamespace>TestAppFx</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
    <RollForward></RollForward>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\TestAppFx\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
